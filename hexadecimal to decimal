#include <stdio.h>

int main()
{
    char hex[20];
    int decimal = 0;
    int i = 0;
    int value;

    printf("Enter a hexadecimal number: ");
    scanf("%s", hex);

    while (hex[i] != '\0')
    {
        if (hex[i] >= '0' && hex[i] <= '9')
            value = hex[i] - '0';

        else if (hex[i] >= 'A' && hex[i] <= 'F')
            value = hex[i] - 'A' + 10;

        else if (hex[i] >= 'a' && hex[i] <= 'f')
            value = hex[i] - 'a' + 10;

        decimal = decimal * 16 + value;

        i++;
    }

    printf("Decimal = %d", decimal);

    return 0;
}
