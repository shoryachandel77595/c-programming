#include <stdio.h>

int main()
{
    int binary, decimal = 0;
    int base = 1;
    int remainder;
    char hex[32];
    int i = 0;

    printf("Enter a binary number: ");
    scanf("%d", &binary);

    /* Binary to Decimal */

    while (binary > 0)
    {
        remainder = binary % 10;

        decimal = decimal + remainder * base;

        base = base * 2;

        binary = binary / 10;
    }

    /* Decimal to Hexadecimal */

    while (decimal > 0)
    {
        remainder = decimal % 16;

        if (remainder < 10)
            hex[i] = remainder + '0';
        else
            hex[i] = remainder - 10 + 'A';

        decimal = decimal / 16;
        i++;
    }

    printf("Hexadecimal = ");

    for (i = i - 1; i >= 0; i--)
    {
        printf("%c", hex[i]);
    }

    return 0;
}
